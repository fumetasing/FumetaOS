#!/bin/bash

set -euo pipefail

SOURCE="$(cd "$(dirname "$0")/.." && pwd)"
PACKAGE="/opt/fumetaos/install/package"
PARENT="${PACKAGE%/*}"
DIRECTORIOS=(bin core modules apps config services sudoers)

echo "🏗️ Construyendo paquete de FumetaOS"
printf 'Origen: %s\nDestino: %s\n' "$SOURCE" "$PACKAGE"

for directorio in "${DIRECTORIOS[@]}"; do
	test -d "$SOURCE/$directorio" || {
		echo "❌ Falta el directorio: $SOURCE/$directorio" >&2
		exit 20
	}
done
test -s "$SOURCE/VERSION"
for archivo in install.sh update.sh; do
	bash -n "$SOURCE/install/$archivo"
done
for regla in "$SOURCE/sudoers/"*; do
	test -f "$regla"
	sudo visudo -cf "$regla"
done

sudo mkdir -p -- "$PARENT"
exec 9<"$PARENT"
if ! flock -n 9; then
	echo "❌ Ya hay otra construcción del paquete en curso." >&2
	exit 20
fi

temporal=$(sudo mktemp -d "$PARENT/.package-build.XXXXXXXX")
trap 'sudo rm -rf --one-file-system -- "$temporal"' EXIT
candidato="$temporal/package"

if [[ -L "$PACKAGE" || ( -e "$PACKAGE" && ! -d "$PACKAGE" ) ]]; then
	echo "❌ El destino del paquete no es un directorio normal." >&2
	exit 20
fi

# Conservar archivos ajenos al constructor, como la documentación del paquete.
if [ -d "$PACKAGE" ]; then
	sudo cp -a -- "$PACKAGE" "$candidato"
else
	sudo install -d -o root -g root -m 755 -- "$candidato"
fi

for directorio in "${DIRECTORIOS[@]}"; do
	sudo rm -rf --one-file-system -- "$candidato/$directorio"
	sudo cp -r -- "$SOURCE/$directorio" "$candidato/"
done

config_privada="$candidato/config/fumetaos.conf"
if sudo test -e "$config_privada" || sudo test -L "$config_privada"; then
	if sudo test -L "$config_privada" || ! sudo test -f "$config_privada"; then
		echo "❌ La configuración privada del paquete debe ser un archivo regular." >&2
		exit 20
	fi
	sudo chown root:server "$config_privada"
	sudo chmod 640 "$config_privada"
fi

sudo chown -R root:root "$candidato/sudoers"
sudo find "$candidato/sudoers" -type d -exec chmod 755 {} +
sudo find "$candidato/sudoers" -type f -exec chmod 440 {} +
sudo chmod -R 755 "$candidato/bin" "$candidato/core" "$candidato/modules" "$candidato/apps"
sudo find "$candidato/services" -type d -exec chmod 755 {} +
sudo find "$candidato/services" -type f -exec chmod 644 {} +

sudo test ! -L "$candidato/install"
for archivo in install.sh update.sh; do
	sudo install -D -o root -g root -m 755 -- "$SOURCE/install/$archivo" "$candidato/install/$archivo"
	sudo bash -n "$candidato/install/$archivo"
done
sudo install -o root -g root -m 644 -- "$SOURCE/VERSION" "$candidato/VERSION"
sudo cmp -- "$SOURCE/VERSION" "$candidato/VERSION"

# renameat2 permite intercambiar dos directorios en una sola operación.
# Con un destino nuevo, NOREPLACE protege contra una creación simultánea.
sudo python3 -B "$SOURCE/core/package-path-exchange.py" "$candidato" "$PACKAGE"

echo "✅ Paquete generado correctamente"
ls -la "$PACKAGE"
