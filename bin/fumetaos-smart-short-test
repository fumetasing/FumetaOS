#!/bin/bash
# Pruebas cortas en ambos discos, después de las copias.
set -uo pipefail

SHORT_LOCK=/run/lock/fumetaos-smart-test.lock

smart_short_error() {
    echo "🔴 $*" >&2
    return 20
}

smart_short_run() {
    local device status attempt busy log first
    exec 8>"$SHORT_LOCK" || return 20
    flock -n 8 || { smart_short_error 'Hay otra prueba SMART de FumetaOS en curso'; return 20; }

    # Comprobar ambos discos antes de iniciar nada.
    for device in "$HDD_DEVICE" "$SSD_DEVICE"; do
        status="$(smartctl_cmd -c "$device" 2>&1)" || {
            smart_short_error "No se pudo consultar $device"; return 20;
        }
        if printf '%s\n' "$status" | grep -qi 'in progress'; then
            smart_short_error "Ya hay una prueba en $device; no se interrumpe"; return 20
        fi
    done

    for device in "$HDD_DEVICE" "$SSD_DEVICE"; do
        smartctl_cmd -t short "$device" || {
            smart_short_error "No se pudo iniciar la prueba corta en $device"; return 20;
        }
    done
    sleep 120

    for ((attempt=1; attempt<=20; attempt++)); do
        busy=0
        for device in "$HDD_DEVICE" "$SSD_DEVICE"; do
            status="$(smartctl_cmd -c "$device" 2>&1)" || return 20
            if printf '%s\n' "$status" | grep -qi 'in progress'; then
                busy=1
            elif ! printf '%s\n' "$status" |
                grep -Eq 'Self-test execution status:[[:space:]]*\([[:space:]]*0\)'; then
                smart_short_error "La prueba corta no terminó correctamente en $device"; return 20
            fi
        done
        [ "$busy" -eq 0 ] && break
        if [ "$attempt" -eq 20 ]; then
            smart_short_error 'La prueba corta sigue en curso tras el plazo previsto'; return 20
        fi
        sleep 30
    done

    log="$(smartctl_cmd -l selftest "$HDD_DEVICE" 2>&1)" || return 20
    first="$(printf '%s\n' "$log" | awk '/^# *1[[:space:]]/ {print; exit}')"
    if [[ "$first" != *Short* || "$first" != *'Completed without error'* ]]; then
        smart_short_error 'El registro del HDD no confirma la última prueba corta'; return 20
    fi
    for device in "$HDD_DEVICE" "$SSD_DEVICE"; do
        status="$(smartctl_cmd -H "$device" 2>&1)" || return 20
        printf '%s\n' "$status" | grep -q PASSED || return 20
    done
    echo '✅ HDD y SSD: pruebas SMART cortas terminadas sin errores; salud SMART correcta'
}

smart_short_main() {
    if [ "$#" -ne 0 ] || [ "$(id -u)" -ne 0 ]; then
        echo 'Ejecutar sin argumentos como root' >&2
        return 20
    fi
    source /opt/fumetaos/core/common.sh
    command -v smartctl >/dev/null 2>&1 || return 20
    local result=0
    smart_short_run || result=$?
    if [ "$result" -ne 0 ] && [ -x /opt/fumetaos/bin/telegram-notify ]; then
        printf '%s\n' '🚨 FumetaOS: falló la prueba SMART corta. Consulta su registro.' |
            /opt/fumetaos/bin/telegram-notify || true
    fi
    return "$result"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    smart_short_main "$@"
fi
