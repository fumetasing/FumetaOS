#!/bin/bash

###########################################################
# FumetaOS
# Verificación global de calidad del código
###########################################################

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

if [ "$#" -ne 0 ]; then
	echo "Uso: $(basename "$0")"
	exit 20
fi

for COMMAND in bash python3 shellcheck shfmt git find sort; do
	if ! command -v "$COMMAND" >/dev/null 2>&1; then
		echo "❌ Falta la herramienta requerida: $COMMAND"
		exit 20
	fi
done

cd "$PROJECT_DIR"

mapfile -d '' CHECK_FILES < <(
	find bin core modules apps install \
		-type f \
		\( -name '*.sh' -o -path 'bin/*' \) \
		-print0 |
		while IFS= read -r -d '' candidate; do
			IFS= read -r shebang <"$candidate" || true
			case "$shebang" in
			'#!/bin/bash'* | '#!/usr/bin/env bash'* | '#!/bin/sh'* | '#!/usr/bin/env sh'*) printf '%s\0' "$candidate" ;;
			esac
		done |
		sort -z
)

echo "🧪 FumetaOS Quality"
echo

echo "===== SINTAXIS ====="

for FILE in "${CHECK_FILES[@]}"; do
	bash -n "$FILE"
done

python3 -B - <<'PYTHON_SYNTAX'
import ast
from pathlib import Path

for directory in ("bin", "core", "modules", "apps", "install"):
    for path in Path(directory).rglob("*"):
        if not path.is_file():
            continue
        content = path.read_bytes()
        if path.suffix == ".py" or content.startswith(
            (b"#!/usr/bin/env python3", b"#!/usr/bin/python3")
        ):
            ast.parse(content, filename=str(path))
PYTHON_SYNTAX

echo "✅ Sintaxis Bash y Python correcta"

echo
echo "===== SHELLCHECK ====="

shellcheck \
	--shell=bash \
	--severity=warning \
	"${CHECK_FILES[@]}"

echo "✅ Sin avisos importantes"

echo
echo "===== FORMATO ====="

shfmt -d "${CHECK_FILES[@]}"

echo "✅ Formato uniforme"

echo
echo "===== GIT ====="

git diff --check

echo "✅ Sin errores de espacios"

echo
echo "✅ Calidad global de FumetaOS verificada"
